# 依赖（体积大，且不随源码走）
node_modules/

# 构建产物
dist/
dist-*/
dist-*

# 编辑器临时构建验证目录
dist-verify/
dist-verify2/
dist-verify3/
dist-fix/
dist-tmp/

# Vite 依赖优化缓存
*.timestamp-*.mjs

# 系统/编辑器
.DS_Store
Thumbs.db
*.log

# 本地草稿（IndexedDB 数据，非源码）
草稿/
draft/

# 样例html
样例HTML工程/

# 设计素材（本地参考图，不入库）
设计素材/

# 临时文件
*.rar
*.zip
pi-session-*.html

# Python
__pycache__/
*.pyc

# vo-pipeline 生成产物（音频/试听/字幕/参数，可由 纯文案+vo.config.json 重新生成）
vo-pipeline/*.mp3
vo-pipeline/*.wav
vo-pipeline/*.m4a
vo-pipeline/*.srt
vo-pipeline/*.voice.json
vo-pipeline/试听/
# 克隆实验遗留（GPT-SoVITS 路线已裁撤，脚本仅本地留档）
vo-pipeline/test_tts.py

# 录制产物不入库（OBS 默认命名 YYYY-MM-DD HH-MM-SS.mp4，已不适用旧 *-录屏-* 模式）
测试工程/*.mp4
测试工程/*绑定复现*.html

# WorkBuddy 项目数据/本地备份不入库
.workbuddy/
